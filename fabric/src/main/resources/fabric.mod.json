{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description} | Fabric Version",
    "authors": ${mod_authors},
    "contact": {
        "homepage": "${homepage_url}",
        "sources": "${source_url}"
    },
    "license": "${license}",
    "icon": "assets/${mod_id}/FabricIcon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "live.gunnablescum.villagerpickup.VillagerPickupFabric"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "accessWidener": "villagerpickup.accesswidener",
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft}",
        "java": ">=${java_version}"
    }
}

